# Terraform working directory
.terraform/

# Terraform state files
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files (often contain credentials)
.terraformrc
terraform.rc

# Terraform variable files (can contain secrets)
*.tfvars
*.tfvars.json

# Ignore Terraform dependency lock file
.terraform.lock.hcl
